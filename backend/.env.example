# ==========================================================================
# BarberShop — variables de entorno de PRODUCCIÓN (ejemplo)
# ==========================================================================
# Copia este fichero y rellénalo. El real (backend/.env) NUNCA se commitea.
# En la VM la ubicación recomendada es /etc/barbershop/barbershop.env con
# chmod 600, cargado por el EnvironmentFile de la unidad systemd
# (deploy/barbershop-backend.service) — ver deploy/README.md.
# Solo placeholders: aquí nunca van valores reales.
# ==========================================================================

# --- Perfil Spring -------------------------------------------------------
# Producción = prod (PostgreSQL local en la VM + ProdSeeder).
# En desarrollo local NO definas esta variable (el perfil por defecto es dev:
# PostgreSQL local, ver backend/README-dev-db.md).
SPRING_PROFILES_ACTIVE=prod

# --- Base de datos (PostgreSQL) ------------------------------------------
# Perfil prod: se conecta a PostgreSQL. Por defecto:
#   jdbc:postgresql://localhost:5432/barbershop   (usuario/contraseña: barbershop)
# En la VM define SIEMPRE credenciales reales distintas de las por defecto:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/barbershop
# SPRING_DATASOURCE_USERNAME=barbershop
# SPRING_DATASOURCE_PASSWORD=
# (crear antes la BD y el usuario en PostgreSQL — deploy/README.md §5bis)

# --- Bootstrap del primer administrador (solo 1er arranque) ---------------
# Obligatorio la primera vez: si la BD está vacía y faltan estas claves no
# existirá ningún usuario con el que entrar. Se ignoran en cuanto hay datos.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- JWT (obligatorio: sin JWT_SECRET la app no arranca) -----------------
# Genera uno con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Seguridad: allowlist CORS (opcional) ---------------------------------
# Vacío por defecto = solo orígenes locales de desarrollo
# (http://localhost:3000, http://localhost:5173, 127.0.0.1:3000/5173).
# En prod la SPA es same-origin vía nginx ⇒ NO hace falta definirla.
# Solo para demo con túnel/dominio externo, lista los orígenes exactos
# (separados por coma, sin comodines "*" — la app no arranca con "*" o vacío):
# CORS_ALLOWED_ORIGINS=https://tu-dominio.example,https://otra-demo.example

# --- Seguridad: rate limiting (opcional, valores por defecto) -------------
# Login: fallos por email+IP y fallos por IP dentro de la ventana (segundos)
# APP_SECURITY_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
# APP_SECURITY_LOGIN_MAX_ATTEMPTS_PER_IP=20
# APP_SECURITY_LOGIN_WINDOW_SECONDS=900
# Reserva pública: peticiones por IP en la ventana y techo diario global
# APP_SECURITY_BOOKING_MAX_PER_IP=10
# APP_SECURITY_BOOKING_WINDOW_SECONDS=3600
# APP_SECURITY_BOOKING_MAX_PER_DAY=100
# Confianza en X-Real-IP/X-Forwarded-For (true detrás de nginx; solo cámbialo
# si el backend queda expuesto sin proxy delante)
# APP_SECURITY_TRUST_PROXY_HEADERS=true

# --- Seguridad: lockout progresivo por cuenta (opcional, valores por defecto) --
# Tercer bucket de login cuya clave es SOLO el email normalizado (sin IP):
# la rotación de IPs de un botnet ya no reinicia el presupuesto de la cuenta.
# Al alcanzar `threshold` fallos en la ventana base, la ventana efectiva pasa a
# min(base-seconds · multiplier^(n - threshold), max-seconds):
#   5 fallos -> 15 min · 6.º -> 30 min · 7.º -> 1 h · … · tope 24 h.
# Cada fallo DURANTE el bloqueo re-armala con ventana más larga; un login
# acertado resetea contador y ventana; sin actividad la ventana expira.
# Los buckets email+IP e IP preexistentes no cambian.
# Rollback/ajuste SIN redeploy de código: cambia estas env vars y reinicia el
# servicio (systemctl restart barbershop-backend).
# APP_SECURITY_LOGIN_LOCKOUT_THRESHOLD=5
# APP_SECURITY_LOGIN_LOCKOUT_BASE_SECONDS=900
# APP_SECURITY_LOGIN_LOCKOUT_MULTIPLIER=2
# APP_SECURITY_LOGIN_LOCKOUT_MAX_SECONDS=86400

# --- Seguridad: anti-bot en el login (opcional, defaults recomendados) -------
# Honeypot `website` ON por defecto: campo tolerado si NO viene (los clientes
# API legítimos siguen funcionando) y rechazado con 401 genérico si llega
# relleno, antes de verificar credenciales ni tocar los buckets.
# Reto X-Login-Challenge y Cloudflare Turnstile OFF: son las capas "exigentes"
# y solo se activan si el propietario lo decide (ver Open Questions del
# cambio harden-sql-injection-anti-bot).
# APP_SECURITY_BOT_HONEYPOT_ENABLED=true
# APP_SECURITY_BOT_HONEYPOT_DELAY_MS=1000
# APP_SECURITY_BOT_CHALLENGE_ENABLED=false
# APP_SECURITY_TURNSTILE_ENABLED=false
# APP_SECURITY_TURNSTILE_SITE_KEY=
# APP_SECURITY_TURNSTILE_SECRET_KEY=
# Si activas Turnstile: el frontend necesita VITE_TURNSTILE_SITE_KEY en el
# momento del BUILD (frontend/.env.example) y la CSP de nginx debe permitir
# challenges.cloudflare.com (deploy/nginx-barbershop.conf).

# --- Seguridad: auditoría de logins fallidos (opcional) -----------------------
# Una línea WARN key=value por intento que NO termina en tokens:
#   event=login_failed email=… ip=… reason=… suspect_ua=… path=… ua="…"
# reason ∈ BAD_CREDENTIALS | ACCOUNT_LOCKED | RATE_LIMITED | HONEYPOT |
# CHALLENGE_FAILED, más una línea INFO event=login_ok en los aciertos.
# Desactivar solo si el volumen de log fuera un problema (rollback por env
# var sin redeploy): el log rotado es la pista de auditoría.
# APP_SECURITY_LOGIN_AUDIT_ENABLED=true

# --- Desarrollo local (NO definir en producción) --------------------------
# Imprime credenciales y token demo de DataSeeder en la consola del arranque
# dev (flujo cómodo local; en prod DataSeeder no se ejecuta igualmente).
# DEMO_PRINT_CREDENTIALS=false

# --- Correo transaccional (Brevo SMTP) ------------------------------------
# MAIL_HOST vacío = modo log: la reserva se crea y el envío se omite con aviso.
# Brevo: usuario = tu email de acceso, contraseña = "SMTP Key" del panel,
# MAIL_FROM = remitente verificado en Brevo.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_ENABLED=true
MAIL_FROM=

# --- Depuración -----------------------------------------------------------
# Dejar en false en producción (evita loguear parámetros SQL/PII).
SHOW_SQL=false
