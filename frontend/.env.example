# ==========================================================================
# BarberShop — variables de compilación del FRONTEND (ejemplo)
# ==========================================================================
# Los VITE_* NO son runtime: Vite los inyecta en el bundle durante
# `npm run build`, así que cambiar cualquiera de ellos exige RECONSTRUIR y
# redesplegar el frontend. (Las APP_SECURITY_* del backend, en cambio, se
# cambian por env var sin redeploy de código — backend/.env.example.)
# Copia este fichero y rellénalo. El real (frontend/.env) NUNCA se commitea.
# ==========================================================================

# --- Origen de la API -------------------------------------------------------
# Producción (SPA servida por nginx, proxy same-origin de /api): ruta relativa.
# VITE_API_BASE_URL=/api
# Desarrollo local (sin proxy):
VITE_API_BASE_URL=http://localhost:8080/api

# --- Anti-bot: reto X-Login-Challenge (opcional, OFF por defecto) -----------
# true = el frontend calcula y envía la cabecera X-Login-Challenge en el
# login (hex(SHA-256("v1|email|minuto")), válido ±1 min). Requiere además
# activar en el backend APP_SECURITY_BOT_CHALLENGE_ENABLED=true.
# Ausente o false: el flujo de login del SPA no cambia en nada (compatibles
# con clientes API legítimos que no envían la cabecera).
# VITE_BOT_CHALLENGE_ENABLED=false

# --- Anti-bot: Cloudflare Turnstile (opcional, sin widget por defecto) -------
# Clave PÚBLICA (site key). Solo si está definida se inyecta el script de
# Cloudflare y se renderiza el widget en el login; vacía = cero widget y
# cero llamadas a terceros. Requiere además en el backend
# APP_SECURITY_TURNSTILE_ENABLED=true + APP_SECURITY_TURNSTILE_SECRET_KEY, y
# que la CSP de nginx permita challenges.cloudflare.com
# (deploy/nginx-barbershop.conf).
# VITE_TURNSTILE_SITE_KEY=
